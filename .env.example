# Copy to .env (next to docker-compose.yml) and set a key of your own.
# Exactly 32 ASCII characters, e.g. from: openssl rand -hex 16
# The public test key (32 zeros) is refused at start.
# Keep the key safe: without it the database and the backups in ./data cannot be read,
# and changing it later makes the existing database unreadable.
GLUTSPEICHER_CRYPTO_KEY=
